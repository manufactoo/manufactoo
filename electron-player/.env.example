# Copia este fichero a ".env" (en esta carpeta para desarrollo, o junto al
# .exe instalado para produccion) y ajusta los valores.
#
# DESARROLLO: no hace falta tocar esto -- "npm run dev" ya pasa estas mismas
# URLs directamente (ver package.json). Este fichero es sobre todo para
# PRODUCCION: cada empresa apunta su Player a SU propio servidor Manufactoo
# sin tener que recompilar nada.

# URL del backend de Manufactoo (API). Obligatoria.
MANUFACTOO_BACKEND_URL=https://manufactoo.miempresa.local

# URL desde la que se sirve el frontend (la pagina /dashboard/stations/:id/run).
# Solo hace falta si el frontend NO esta en el mismo origen que el backend
# (p. ej. en desarrollo: backend en :8080, Vite en :5173). En una instalacion
# normal (mismo dominio/reverse proxy para ambos), se puede omitir: usa
# MANUFACTOO_BACKEND_URL por defecto.
# MANUFACTOO_FRONTEND_URL=https://manufactoo.miempresa.local

# Ventana normal en vez de pantalla completa (solo para probar en un PC de
# desarrollo; en planta siempre se quiere pantalla completa).
# MANUFACTOO_PLAYER_WINDOWED=1
