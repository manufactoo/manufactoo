# Copiar a .env y rellenar antes de "docker compose up" en produccion.
# No commitear .env (ya excluido en .gitignore).

MANUFACTOO_VERSION=0.1.0

DB_NAME=manufactoo
DB_USER=manufactoo
DB_PASSWORD=changeme-strong-password

JWT_SECRET=changeme-strong-random-secret

# Dominio publico servido tras el Cloudflare Tunnel, ej: https://mes.miempresa.com
MANUFACTOO_PUBLIC_ORIGIN=https://mes.example.com

CLOUDFLARE_TUNNEL_TOKEN=changeme-cloudflare-tunnel-token
